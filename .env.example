# Copy to .env.local and fill in. Never commit .env.local.

# Neon pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ca-central-1.aws.neon.tech/neondb?sslmode=require

APP_URL=http://localhost:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# AWS S3 (or S3-compatible: set S3_ENDPOINT for MinIO/R2)
S3_BUCKET=goblin-coffee-assets
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=https://cdn.goblincoffee.ca

# Resend (verify your sending domain first)
RESEND_API_KEY=
EMAIL_FROM="Goblin Coffee <orders@goblincoffee.ca>"

# Where customers send Interac e-Transfers
ETRANSFER_EMAIL=
